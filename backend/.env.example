# Conexión a la base de datos. El valor de abajo apunta al Postgres que levanta
# `docker compose up -d` desde la raíz del repo (user/pass/db: quilt). Si usás
# tu propio Postgres (ej. un homelab), reemplazá por esa conexión.
DATABASE_URL=postgresql://quilt:quilt@localhost:5432/quilt

# Configuración JWT y Seguridad (FastAPI / PyJWT / python-jose)
SECRET_KEY=tu_secret_key_super_segura
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15

# Límite de tamaño para imágenes subidas por creadores (minijuego de imágenes)
MAX_UPLOAD_SIZE_MB=5

# Orígenes permitidos por CORS, separados por coma (ej: http://localhost:5173,http://192.168.0.7:5173).
# Sin configurar, cae a "*" (cualquier origen) — recomendado fijarlo en producción.
CORS_ORIGINS=*

# Cuenta inicial opcional para levantar el proyecto (backend/seed.py).
# Si no se setean, seed.py solo crea las tablas y no crea ninguna cuenta.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=